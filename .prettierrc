{
    "tabWidth": 4,
    "useTabs": false,
    "printWidth": 200,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5",
    "bracketSpacing": true,
    "arrowParens": "always",
    "embeddedLanguageFormatting": "auto",
    "plugins": ["prettier-plugin-tailwindcss"],
    "tailwindStylesheet": "./app/assets/css/main.css"
}
